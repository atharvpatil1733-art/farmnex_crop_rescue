# Copy to .env for LOCAL development of this repo. Never commit .env.
# In the main backend, these are optional: pass the backend's engine via crop_rescue.configure(engine=...)
# and set only the CR_ values you want to change.

# Supabase (same project as the main FarmNex app): session pooler string with the psycopg driver
CR_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Local tests (docker compose db service)
CR_TEST_DATABASE_URL=postgresql+psycopg://farmnex:farmnex@localhost:5433/crop_rescue_test

# Engine (defaults shown; the ones marked ASSUMPTION are modelling choices, not data)
CR_CHECK_INTERVAL_HOURS=12
CR_ALERT_HOURS=48
CR_Q10=2.0                   # ASSUMPTION: rule-of-thumb 2-3, conservative end
CR_DEFAULT_TEMP_C=30         # ASSUMPTION: Pune-area afternoon
CR_USE_OPEN_METEO=false

# Matching (all ASSUMPTIONS for the prototype)
CR_RADIUS_KM=50
CR_ROAD_FACTOR=1.3
CR_AVG_SPEED_KMPH=35
CR_LOADING_HOURS=2
CR_TRANSPORT_RS_PER_KM=25
CR_TOP_N=3

CR_ENABLE_SCHEDULER=true
